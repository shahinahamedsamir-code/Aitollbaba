# Apache / LiteSpeed config for the exported static site.
# Hostinger shared hosting reads this from the site's public_html folder.

# No directory listings, and do not redirect /guides to /guides/ — there is a
# guides.html page *and* a guides/ folder, and the page must win.
Options -Indexes
DirectorySlash Off

# ---------------------------------------------------------------- routing
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Hostinger issues the certificate; this makes sure nothing is
  # served over plain HTTP once it exists.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # One host. www and the bare domain were both answering 200, which is the
  # whole site duplicated at a second address.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # One address per page. The export writes qr-generator.html and the site
  # links to /qr-generator; without this both answered 200. Matched against
  # THE_REQUEST so it sees the address the visitor actually asked for, not the
  # rewritten one the last rule in this block produces.
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Drop a trailing slash so /instagram/ and /instagram are not two URLs.
  # The canonical tags and the sitemap both use the no-slash form.
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # The export writes instagram.html, guides.html, guides/what-is-c2pa.html.
  # Serve those for extensionless URLs, which is what every link uses.
  # Deliberately no !-d test: /guides must resolve to guides.html even though
  # a guides/ directory exists beside it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# The social card and the home-screen icon are exported as extensionless
# files, so their type has to be declared or crawlers and iOS receive them as
# octet-stream and ignore them.
<FilesMatch "^(opengraph-image|apple-icon)$">
  ForceType image/png
</FilesMatch>

# ------------------------------------------------------------- compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------------ caching
<IfModule mod_expires.c>
  ExpiresActive On

  # Everything under /_next/static carries a content hash in its filename, so
  # a new build produces new names and these can be cached indefinitely.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # HTML must revalidate, or visitors keep an old page after a redeploy.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------ headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# The tool needs no network access at all once loaded, so nothing here opens
# an outbound connection. Keep it that way.
